# LinkedIn API Configuration (git + GitHub Action publisher)
# Get your access token from https://www.linkedin.com/developers/apps

LINKEDIN_ACCESS_TOKEN=your_access_token_here

# Optional: npm run get-profile fills this. posting will fetch it if omitted.
LINKEDIN_PERSON_URN=urn:li:person:XXXXXXXX

# Optional: Posts API version header (YYYYMM)
LINKEDIN_VERSION=202608

# Content Studio (React + Nest + Postgres): copy apps/api/.env.example
# and see docs/CONTENT_STUDIO.md
